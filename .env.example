# Copy this file to ".env" and fill in only what you use.
# ".env" is ignored by git. Never put a Google account password here.

# AI for picking moments: "agy" (Antigravity command-line tool, signed in) or "api" (Gemini API key)
CLIPFORGE_GEMINI_ROUTE=agy

# Models tried in order on the "agy" route. Tested 2026-11-15: claude-sonnet-4-6 answered
# reliably; the Gemini tiers returned empty replies or timed out.
CLIPFORGE_AGY_MODELS=claude-sonnet-4-6,gemini-3.8-flash-medium

# Only for CLIPFORGE_GEMINI_ROUTE=api (this route is written but has not been run yet).
# Create a key at https://aistudio.google.com/apikey and name the model to use.
GEMINI_API_KEY=
CLIPFORGE_GEMINI_MODEL=

# Speech-to-text. Model: "small" (default) or "base" (about 2.5x faster, a little less accurate).
# Detection: "sensitive" (default), "normal" (fastest, misses speech under music),
# or "off" (most complete, about 6x slower).
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_SPEECH_DETECTION=sensitive
CLIPFORGE_LANGUAGE=auto

# Optional, for video metadata lookups
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
