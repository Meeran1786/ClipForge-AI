# Copy this file to ".env" and fill in only what you use.
# ".env" is ignored by git. Never put a Google account password here.

# Which Gemini route to use: "agy" (Antigravity CLI, already signed in) or "api"
CLIPFORGE_GEMINI_ROUTE=agy

# Only needed when CLIPFORGE_GEMINI_ROUTE=api. Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Speech-to-text. Model: "small" (default) or "base" (about 2.5x faster, a little less accurate).
# Detection: "sensitive" (default), "normal" (fastest, misses speech under music),
# or "off" (most complete, about 6x slower).
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_SPEECH_DETECTION=sensitive
CLIPFORGE_LANGUAGE=auto

# Optional, for video metadata lookups
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
